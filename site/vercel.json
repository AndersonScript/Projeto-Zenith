{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/baixar",
      "destination": "https://github.com/AndersonScript/Projeto-Zenith/releases/latest/download/ZenithLauncher.exe",
      "permanent": false
    },
    {
      "source": "/limpar",
      "destination": "https://github.com/AndersonScript/Projeto-Zenith/releases/latest/download/LimparZenith.exe",
      "permanent": false
    },
    {
      "source": "/apk",
      "destination": "https://github.com/AndersonScript/Projeto-Zenith/releases/download/v1.0/Zenith.apk",
      "permanent": false
    },
    {
      "source": "/android",
      "destination": "https://github.com/AndersonScript/Projeto-Zenith/releases/download/v1.0/Zenith.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'" }
      ]
    },
    {
      "source": "/(latest|versions).json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ]
}
